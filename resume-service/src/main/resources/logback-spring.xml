<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="appEnv" source="spring.profiles.active" defaultValue="production"/>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <customFields>{"service":"resume-service","environment":"${appEnv}"}</customFields>
        </encoder>
    </appender>

    <!-- FILE appender removed: containers log to stdout; Render captures stdout/stderr -->

    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON"/>
    </root>

    <logger name="com.resumeforge" level="DEBUG"/>
</configuration>
